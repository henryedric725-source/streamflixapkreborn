# Canonical origin. Drives canonical tags, Open Graph URLs, and robots host.
NEXT_PUBLIC_SITE_URL=https://streamflixreborn.com

# The sitemap is only reachable at /private-sitemap/<this value>.
SITEMAP_SECRET=generate-a-long-random-string

# Shown on the About, DMCA, and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=contact@streamflixreborn.com

# Optional search-console verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Optional social profiles. Empty values are dropped from Organization sameAs.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_REDDIT_URL=

# Optional author sameAs profiles. Empty values are dropped from Person sameAs.
NEXT_PUBLIC_AUTHOR_GITHUB=
NEXT_PUBLIC_AUTHOR_LINKEDIN=
NEXT_PUBLIC_AUTHOR_TWITTER=
