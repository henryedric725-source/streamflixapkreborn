{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamflix-apk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "build": {
    "command": "npx opennextjs-cloudflare build",
    "watch_dir": "."
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    // TODO: replace with the real domain before deploying. Canonicals, Open
    // Graph URLs and robots host all derive from this.
    "NEXT_PUBLIC_SITE_URL": "https://streamflixapk.example",
    // TODO: replace with a generated secret. The sitemap is only reachable at
    // /private-sitemap/<this value>.
    "SITEMAP_SECRET": "REPLACE_ME_BEFORE_DEPLOY",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "streamflix-apk",
    },
  ],
}
